  m_Script: {fileID: 11500000, guid: 3d8fe1987deb41aaaf3eec00a9c482a0, type: 3}
  m_Name: ElderRowan
  m_EditorClassIdentifier: 
  NpcName: Elder Rowan
  Nodes:
  - Text: Greetings, traveler. Violetstown has endured many storms, yet we stand resilient.
    Options:
    - Text: Tell me about Violetstown.
      NextNode: 1
      Action: 0
      QuestID:
      RequiredQuestID:
      RequiredState: 0
    - Text: Any advice for survival?
      NextNode: 2
      Action: 0
      QuestID:
      RequiredQuestID:
      RequiredState: 0
    - Text: Farewell.
      NextNode: -1
      Action: 0
      QuestID:
      RequiredQuestID:
      RequiredState: 0
  - Text: Our town thrives because every villager shoulders a craft. Woodcutters keep the hearths
      warm and miners unearth the ores that forge our blades.
    Options:
    - Text: Thanks for the history.
      NextNode: -1
      Action: 0
      QuestID:
      RequiredQuestID:
      RequiredState: 0
  - Text: "Keep your tools sharp, your rations stocked, and your allies close. Preparation is the true
      secret to surviving the wilds beyond our walls."
    Options:
    - Text: "I'll remember that."
      NextNode: -1
      Action: 0
      QuestID:
      RequiredQuestID:
      RequiredState: 0
